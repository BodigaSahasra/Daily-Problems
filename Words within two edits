class Solution:
    def twoEditWords(self, queries: List[str], dictionary: List[str]) -> List[str]:
        ans = []
        for q in queries:
            for s in dictionary:
                dis = 0
                for i in range(len(q)):
                    if(q[i] != s[i]):
                        dis += 1
                if dis <= 2:
                    ans.append(q)
                    break
        return ans
